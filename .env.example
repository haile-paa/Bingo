# Copy to .env for local testing. On Render set these in Environment (never commit real values).
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true
BOT_TOKEN=123456:telegram-bot-token-from-botfather
BOT_USERNAME=Big_bingoo_bot
WEBHOOK_SECRET=long-random-string-40-chars-or-more
ADMIN_KEY=long-random-string-40-chars-or-more
MINIAPP_URL=https://your-app.onrender.com
TELEBIRR_NUMBER=09XXXXXXXX
TELEBIRR_NAME=Name On Your Telebirr
SUPPORT_USER=your_support_telegram_username
VERIFY_ET_API_KEY=VERIFY_BANK_ET_your_key_here
# Finance dashboard at /finance (owner only). Leave both empty to keep it switched off.
OWNER_PHONE=09XXXXXXXX
OWNER_PASSWORD=a-long-password-at-least-10-characters
# NEVER set DEV=1 in production (the server refuses to start on Render if you do)
